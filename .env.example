############################################
# ---------- تنظیمات اصلی ربات ----------- #
############################################
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
# آیدی عددی ادمین‌ها (با کاما جدا شود) - می‌توانید با @userinfobot بگیرید
ADMIN_IDS=111111111,222222222
SUPPORT_USERNAME=@your_support_username
# اختیاری: آیدی عددی کانال جهت عضویت اجباری (خالی بگذارید اگر نمی‌خواهید)
FORCE_JOIN_CHANNEL_ID=
FORCE_JOIN_CHANNEL_USERNAME=

############################################
# ------------- دیتابیس Postgres --------- #
############################################
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vpn_bot
DB_USER=vpn_bot
DB_PASSWORD=change_me

############################################
# --------------- زرین‌پال ---------------- #
############################################
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
# آدرسی که سرور کال‌بک روی آن بالا می‌آید (برای تست لوکال از ngrok استفاده کنید)
ZARINPAL_CALLBACK_BASE_URL=http://127.0.0.1:8080
CALLBACK_SERVER_HOST=0.0.0.0
CALLBACK_SERVER_PORT=8080

############################################
# ------------- کارت به کارت -------------- #
############################################
CARD_NUMBER=6037-9975-XXXX-XXXX
CARD_HOLDER_NAME=نام و نام خانوادگی
CARD_BANK_NAME=بانک ملی

############################################
# ---------------- رمزارز ----------------- #
############################################
# هر کدام از این‌ها را که نمی‌خواهید فعال باشد خالی بگذارید
CRYPTO_USDT_TRC20_ADDRESS=
CRYPTO_USDT_BEP20_ADDRESS=
CRYPTO_BTC_ADDRESS=
CRYPTO_TON_ADDRESS=

############################################
# ------------- نرخ تبدیل ارز ------------- #
############################################
CURRENCY_LABEL=تومان

############################################
# --------------- پنل‌های سنایی (3x-ui) --- #
############################################
# اسم کوتاه پنل‌ها را اینجا با کاما لیست کنید. هر پنل باید متغیرهای زیر را با همین کلید داشته باشد.
PANELS=de1,fr1

PANEL_de1_NAME=🇩🇪 آلمان
PANEL_de1_URL=https://your-panel-domain-1.com:2053
# توکن API که از داخل پنل سنایی (بخش API / Token) گرفتی
PANEL_de1_API_TOKEN=your_api_token_here
PANEL_de1_INBOUND_ID=1
# پروتکل ساخت لینک کانفیگ: vless یا vmess
PANEL_de1_PROTOCOL=vless

PANEL_fr1_NAME=🇫🇷 فرانسه
PANEL_fr1_URL=https://your-panel-domain-2.com:2053
PANEL_fr1_API_TOKEN=your_api_token_here
PANEL_fr1_INBOUND_ID=1
PANEL_fr1_PROTOCOL=vless
